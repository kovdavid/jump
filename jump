#!/bin/bash

function __davsx_jump {
	JUMP_FILES=${DAVSX_JUMP_FILES:-~/.jump}

	read -r -d '' HELP << END_HELP
Usage:
	$0 help - get help
	$0 list - list all jump aliases
	$0 get X - get jump target for X
	$0 set X - set jump target for X to current directory
	$0 set X DIR - set jump target for X to DIR
	$0 remove X - remove jump alias for X
END_HELP

	JUMP_FILE_CONTENT=""
	for JUMP_FILE in ${JUMP_FILES//,/ }; do
		if [ ! -f $JUMP_FILE ] ; then
			touch $JUMP_FILE
		else
			JUMP_FILE_CONTENT="$JUMP_FILE_CONTENT\n$(cat $JUMP_FILE)"
		fi
	done


	if [ -z "$1" ] ; then
		echo -e "$HELP"
		return 1
	fi

	if [ "$1" == "list" ] ; then
		echo -e "$JUMP_FILE_CONTENT"
		return 0
	elif [ "$1" == "get" ] ; then
		if [ -z "$2" ] ; then
			echo "Usage: $0 $1 alias"
			return 1
		fi

		DIR=$(echo -e "$JUMP_FILE_CONTENT" | grep "^$2\>" | cut -f2)
		if [ -z $DIR ] ; then
			echo "Entry not found for $2"
			return 1
		else
			echo $DIR
			return 0
		fi
	elif [ "$1" == "set" ] ; then
		if [ -z "$2" ] ; then
			echo "Jump alias missing"
			echo -e "$HELP"
			return 1
		fi

		TARGET=${3:-$(pwd)}

		FIRST_JUMP_FILE=${JUMP_FILES%%,*}

		DIR=$(grep "^$2\b" $FIRST_JUMP_FILE | cut -f2)
		if [ -z $DIR ] ; then
			echo -e "$2\t$TARGET" >> $FIRST_JUMP_FILE
			return 0
		else
			echo "$2 is already aliased to $DIR"
			return 1
		fi
	elif [ "$1" == "remove" ] ; then
		if [ -z "$2" ] ; then
			echo "Jump alias missing"
			echo -e "$HELP"
			return 1
		fi

		for JUMP_FILE in ${JUMP_FILES//,/ }; do
			sed -i "/^$2\t/d" $JUMP_FILE
		done

		return 0
	elif [ "$1" == "help" ] ; then
		echo -e "$HELP"
		return 0
    else
		DIR=$(echo -e "$JUMP_FILE_CONTENT" | grep "^$1\s" | head -n1 | cut -f2)
		if [ -z $DIR ] ; then
			echo "$1 is not aliased"
			return 1
		else
			DIR=${DIR/#\~/$HOME}

			cd "$DIR"

			if [ -n "$2" ] && [ -d "$2" ] ; then
				cd "$2"
			fi

			return 0
		fi
	fi
}
